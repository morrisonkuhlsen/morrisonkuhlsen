---
layout: null
permalink: /search.json
---
{%- comment -%}
  Índice de busca. Entram os posts e as páginas que têm título e layout —
  isso exclui os assets processados e as ferramentas em HTML avulso.
{%- endcomment -%}
{%- assign pages = site.pages | where_exp: "p", "p.title" | where_exp: "p", "p.layout" | where_exp: "p", "p.layout != 'null'" -%}
{%- assign items = site.posts | concat: pages -%}
[
{%- for item in items -%}
{
"t": {{ item.title | jsonify }},
"u": {{ item.url | relative_url | jsonify }},
"e": {{ item.description | default: item.excerpt | default: item.content | strip_html | normalize_whitespace | truncatewords: 38 | jsonify }},
"g": {{ item.tags | default: empty | join: " " | jsonify }},
"l": {{ item.lang | default: site.lang | jsonify }},
"d": {% if item.date %}{{ item.date | date: "%d/%m/%Y" | jsonify }}{% else %}""{% endif %},
"k": {% if item.date %}"post"{% else %}"page"{% endif %}
}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
